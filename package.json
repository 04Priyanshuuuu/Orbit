{
  "name": "orbit-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Offline-first floating productivity widget",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "preview": "electron-vite preview",
    "dist:win": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "local.orbit.productivity",
    "productName": "Orbit",
    "directories": {
      "buildResources": "build"
    },
    "files": ["out/**/*", "package.json"],
    "win": {
      "target": ["portable"],
      "icon": "build/icon.ico",
      "artifactName": "${productName}.${ext}"
    }
  }
}